<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<svg xmlns="http://www.w3.org/2000/svg" width="2308" height="1274" viewBox="0 0 2308 1274">
  <title>数据中台数据流（可编辑图形，文字未转换）</title>
  <desc>依据原图重建的可编辑 SVG。所有可见文字按要求省略。</desc>
  <defs>
    <marker id="arrow-black" viewBox="0 0 12 12" refX="10" refY="6" markerWidth="12" markerHeight="12" orient="auto" markerUnits="userSpaceOnUse">
      <path d="M0,0 L12,6 L0,12 Z" fill="#111111"/>
    </marker>
  </defs>

  <rect id="page" x="0" y="0" width="2308" height="1274" fill="#ffffff" stroke="#c8c8c8"/>
  <rect id="header-line" x="0" y="143" width="2300" height="2" fill="#111111"/>

  <!-- 页面浅色分区 -->
  <rect id="zone-left" x="43" y="158" width="203" height="1116" fill="#e9f1f9" fill-opacity="0.9"/>
  <rect id="zone-center-top" x="280" y="158" width="1697" height="160" fill="#e9f1f9" fill-opacity="0.9"/>
  <rect id="zone-center-service" x="280" y="343" width="1697" height="213" fill="#e9f1f9" fill-opacity="0.9"/>
  <rect id="zone-center-lake" x="280" y="574" width="1697" height="500" fill="#e9f1f9" fill-opacity="0.9"/>
  <rect id="zone-center-source" x="280" y="1085" width="1697" height="189" fill="#e9f1f9" fill-opacity="0.9"/>
  <rect id="zone-right" x="2001" y="158" width="256" height="1116" fill="#e9f1f9" fill-opacity="0.9"/>
  <rect id="rail-left" x="65" y="271" width="163" height="942" rx="18" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>
  <rect id="rail-right" x="2031" y="271" width="198" height="942" rx="18" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>

  <!-- 背景卡片 -->
  <rect id="top-panel" x="452" y="178" width="1494" height="122" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>
  <rect id="top-card-1" x="470" y="228" width="406" height="54" rx="12" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>
  <rect id="top-card-2" x="924" y="228" width="496" height="54" rx="12" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>
  <rect id="top-card-3" x="1449" y="228" width="497" height="54" rx="12" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>
  <rect id="service-card-1" x="478" y="369" width="466" height="69" rx="12" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>
  <rect id="service-card-2" x="969" y="369" width="466" height="69" rx="12" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>
  <rect id="service-card-3" x="1462" y="369" width="466" height="69" rx="12" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>
  <rect id="service-card-4" x="478" y="464" width="466" height="68" rx="12" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>
  <rect id="service-card-5" x="969" y="464" width="466" height="68" rx="12" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>
  <rect id="service-card-6" x="1462" y="464" width="466" height="68" rx="12" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>
  <rect id="lake-panel-1" x="493" y="726" width="643" height="241" rx="14" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>
  <rect id="lake-panel-2" x="1254" y="726" width="642" height="322" rx="14" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>
  <rect id="lake-panel-3" x="1272" y="882" width="605" height="82" rx="12" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>
  <rect id="lake-panel-4" x="1272" y="966" width="605" height="82" rx="12" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>
  <rect id="obs-panel" x="493" y="982" width="643" height="67" rx="14" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>
  <rect id="source-card-1" x="451" y="1184" width="164" height="70" rx="10" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>
  <rect id="source-card-2" x="670" y="1184" width="164" height="70" rx="10" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>
  <rect id="source-card-3" x="893" y="1184" width="164" height="70" rx="10" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>
  <rect id="source-card-4" x="1115" y="1184" width="164" height="70" rx="10" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>
  <rect id="source-card-5" x="1336" y="1184" width="164" height="70" rx="10" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>
  <rect id="source-card-6" x="1558" y="1184" width="164" height="70" rx="10" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>
  <rect id="source-card-7" x="1780" y="1184" width="164" height="70" rx="10" fill="#ffffff" fill-opacity="0.75" stroke="#d9d9d9" stroke-width="2"/>

  <!-- 核心组件 -->
  <rect id="downstream-system" x="520" y="173" width="1135" height="68" rx="13" fill="#c7c7c7" stroke="#17385e" stroke-width="2.5"/>
  <rect id="service-platform" x="518" y="381" width="1137" height="52" rx="13" fill="#9ed8f5" stroke="#17385e" stroke-width="2.5"/>
  <rect id="indicator-platform" x="705" y="463" width="467" height="45" rx="9" fill="#9ed8f5" stroke="#17385e" stroke-width="2.5"/>
  <rect id="tag-platform" x="1382" y="460" width="466" height="47" rx="9" fill="#9ed8f5" stroke="#17385e" stroke-width="2.5"/>
  <rect id="dws-database" x="775" y="539" width="880" height="91" rx="18" fill="#fff2d6" stroke="#17385e" stroke-width="2.5"/>
  <rect id="component-store" x="1596" y="653" width="219" height="74" rx="5" fill="#fff2d6" stroke="#17385e" stroke-width="2.5"/>
  <rect id="spark-platform" x="468" y="792" width="1264" height="77" rx="5" fill="#fff2d6" fill-opacity="0.96" stroke="#17385e" stroke-width="2.5"/>
  <rect id="obs-storage" x="468" y="944" width="438" height="61" rx="5" fill="#fff2d6" stroke="#17385e" stroke-width="2.5"/>
  <rect id="batch-platform" x="624" y="1090" width="408" height="62" fill="#9ed8f5" stroke="#17385e" stroke-width="2.5"/>

  <!-- 关系型数据库圆柱 -->
  <rect id="database-body" x="628" y="1207" width="164" height="48" fill="#d6d6d6" stroke="#111111" stroke-width="2.5"/>
  <ellipse id="database-bottom" cx="710" cy="1255" rx="82" ry="9" fill="#d6d6d6" stroke="#111111" stroke-width="2.5"/>
  <ellipse id="database-top" cx="710" cy="1207" rx="82" ry="9" fill="#111111" stroke="#111111" stroke-width="2.5"/>
  <polygon id="data-file" points="883,1198 1029,1198 1012,1263 866,1263" fill="#d6d6d6" stroke="#111111" stroke-width="2.5"/>

  <!-- 蓝色说明气泡，文字按要求省略 -->
  <path id="callout-top-left" d="M474 268 H810 V284 L854 310 L810 310 V361 H474 Z" fill="#3b78c8" stroke="#17385e" stroke-width="2.5"/>
  <path id="callout-top-right" d="M1182 270 H1520 V363 H1182 V316 L1159 316 L1182 285 Z" fill="#3b78c8" stroke="#17385e" stroke-width="2.5"/>
  <path id="callout-mid-left" d="M247 598 H610 V626 L640 644 L610 652 V668 H247 Z" fill="#3b78c8" stroke="#17385e" stroke-width="2.5"/>
  <path id="callout-mid-right" d="M1846 577 H2210 V682 H1846 V663 L1817 648 L1846 632 Z" fill="#3b78c8" stroke="#17385e" stroke-width="2.5"/>
  <path id="callout-obs" d="M129 847 H453 V901 L655 918 L453 925 V943 H129 Z" fill="#3b78c8" stroke="#17385e" stroke-width="2.5"/>
  <path id="callout-source" d="M162 1089 H570 V1111 L619 1127 L570 1143 V1184 H162 Z" fill="#3b78c8" stroke="#17385e" stroke-width="2.5"/>
  <path id="callout-large" d="M1794 797 H2231 V1179 H1794 V878 L1744 837 L1794 853 Z" fill="#3b78c8" stroke="#17385e" stroke-width="2.5"/>

  <!-- 主数据流箭头 -->
  <path id="arrow-downstream-to-service" d="M857 242 L859 381" fill="none" stroke="#111111" stroke-width="2.5" marker-end="url(#arrow-black)"/>
  <path id="arrow-service-to-downstream" d="M1145 381 L1143 242" fill="none" stroke="#111111" stroke-width="2.5" marker-end="url(#arrow-black)"/>
  <path id="arrow-indicator-to-service" d="M939 463 L939 433" fill="none" stroke="#111111" stroke-width="2.5" marker-end="url(#arrow-black)"/>
  <path id="arrow-tag-to-service" d="M1578 460 L1578 433" fill="none" stroke="#111111" stroke-width="2.5" marker-end="url(#arrow-black)"/>
  <path id="arrow-dws-to-indicator" d="M939 539 L939 508" fill="none" stroke="#111111" stroke-width="2.5" marker-end="url(#arrow-black)"/>
  <path id="arrow-dws-to-service" d="M1238 539 L1239 433" fill="none" stroke="#111111" stroke-width="2.5" marker-end="url(#arrow-black)"/>
  <path id="arrow-store-to-tag" d="M1710 653 L1710 507" fill="none" stroke="#111111" stroke-width="2.5" marker-end="url(#arrow-black)"/>
  <path id="arrow-spark-to-store" d="M1706 792 L1707 727" fill="none" stroke="#111111" stroke-width="2.5" marker-end="url(#arrow-black)"/>
  <path id="arrow-spark-to-dws" d="M868 792 L869 630" fill="none" stroke="#111111" stroke-width="2.5" marker-end="url(#arrow-black)"/>
  <path id="arrow-spark-to-service" d="M648 792 L646 433" fill="none" stroke="#111111" stroke-width="2.5" marker-end="url(#arrow-black)"/>
  <path id="arrow-obs-to-spark" d="M687 944 L689 869" fill="none" stroke="#111111" stroke-width="2.5" marker-end="url(#arrow-black)"/>
  <path id="arrow-batch-to-obs" d="M833 1090 L833 1005" fill="none" stroke="#111111" stroke-width="2.5" marker-end="url(#arrow-black)"/>
  <path id="arrow-database-to-batch" d="M716 1198 L717 1152" fill="none" stroke="#111111" stroke-width="2.5" marker-end="url(#arrow-black)"/>
  <path id="arrow-file-to-batch" d="M947 1198 L947 1152" fill="none" stroke="#111111" stroke-width="2.5" marker-end="url(#arrow-black)"/>
</svg>
